<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin the package source and CLEAR inherited fallback package folders. Without the <clear/>, a
  machine/host-level config can leak Windows-only fallback folders (e.g. the Visual Studio shared
  NuGet folder) into restore, which then fails on Linux/CI with
  "Unable to find fallback package folder 'C:\Program Files (x86)\...'". Keeping this at the repo
  root makes restore reproducible everywhere (sandbox, CI, any dev machine).
-->
<configuration>
  <config>
    <!-- Repo-relative global packages folder (resolves against this file's dir). Pins the restore
         location deterministically so no host/machine config can leak an absolute drive path
         (e.g. p:\packages) into assets/g.props. Gitignored; portable across sandbox and CI. -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
