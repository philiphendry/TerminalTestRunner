<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ttr.Tests</RootNamespace>
    <AssemblyName>ttr.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ttr.Core/ttr.Core.csproj" />
    <ProjectReference Include="../../src/ttr.Ui/ttr.Ui.csproj" />
    <ProjectReference Include="../../src/ttr.Runners/ttr.Runners.csproj" />
    <ProjectReference Include="../../src/ttr.Build/ttr.Build.csproj" />
    <!-- Phase 5: the watch subsystem (Debouncer, watch sources, coordinator) lives in the composition
         root; the test project references it to unit/integration-test that code (referencing an Exe
         project is supported — its output assembly is used). -->
    <ProjectReference Include="../../src/ttr.Cli/ttr.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The snapshot suite is the UX contract (brief M7 / plan §12). -->
    <PackageReference Include="Verify.Xunit" />
  </ItemGroup>

</Project>
