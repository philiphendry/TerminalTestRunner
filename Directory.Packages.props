<Project>

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production dependencies (Phase 1) -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />

    <!-- Phase 2: ColorCode.Core (pre-approved in the brief) is used ONLY to tokenise source for the
         'o' modal; a hand-written span mapper turns its scopes into terminal colours (its shipped
         formatters emit HTML). -->
    <PackageVersion Include="ColorCode.Core" Version="2.0.15" />

    <!-- Phase 3 (pre-approved in the brief). MSBuildLocator loads the SDK's real (18.x) MSBuild at
         runtime; the Microsoft.Build.* packages are COMPILE-TIME type surface only, so they carry
         ExcludeAssets="runtime" (CLAUDE.md / plan §7 — silences NU1903 and avoids version-mismatch
         loads). 17.14.x is the family the plan validated against the .NET 10 SDK. -->
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build" Version="17.14.28" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.14.28" />
    <!-- Transitive MSBuild utility; excluded from runtime + kept private so it never flows to output
         or to consumers (MSBuildLocator loads the SDK's copy). Version tracks the resolved graph. -->
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.4.0" />
    <!-- Solution (.sln/.slnx) parsing, pinned 1.0.52 (plan §4 / POC-7). -->
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <!-- VSTest discovery via the translation layer (plan §6.3); talks to the SDK's vstest.console. -->
    <PackageVersion Include="Microsoft.TestPlatform.TranslationLayer" Version="18.7.0" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.7.0" />
    <!-- MTP server-mode JSON-RPC (plan §6.4). 2.25.29 pulls the patched MessagePack 2.5.302
         (2.22's MessagePack 2.5.192 trips NU1902/NU1903). -->
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />

    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Phase 2: Verify snapshot suite is the UX contract (brief M7 / plan §12). -->
    <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
  </ItemGroup>

</Project>
